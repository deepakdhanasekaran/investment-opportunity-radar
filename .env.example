# Copy to .env and fill in. NEVER commit .env.
POSTGRES_PASSWORD=change-me-long-random

# API bearer token (the dashboard server uses it). Generate: openssl rand -hex 32
RADAR_API_TOKEN=
RADAR_DASHBOARD_URL=http://localhost:4000

# Notifications via ntfy (primary). Use a long, unguessable topic on ntfy.sh, or your own server + token.
RADAR_NTFY_URL=https://ntfy.sh/change-me-unguessable-topic
RADAR_NTFY_TOKEN=
# Telegram is still supported but unused unless both are set:
# RADAR_TELEGRAM_BOT_TOKEN=
# RADAR_TELEGRAM_CHAT_ID=

# lexicon (default, no extra install) | finbert (build with INSTALL_SENTIMENT=1)
RADAR_SENTIMENT_BACKEND=lexicon
RADAR_LOG_LEVEL=INFO

# Thresholds (nested, double underscore). Examples:
# RADAR_SCAN__DAILY_DROP_PCT=3
# RADAR_SCAN__FIVE_DAY_DROP_PCT=5
# RADAR_SCAN__INTERVAL_MINUTES=15
# RADAR_SCAN__MARKETS=["SE","US"]
# RADAR_ALERTS__MAX_PER_DAY=10
# RADAR_CLS__GREEN_MIN_QUALITY=65

# Dashboard (frontend/dashboard). Same values go into Vercel env if hosted there.
RADAR_API_URL=http://localhost:8000
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
# Dashboard exposure: 127.0.0.1 = this machine only (default; use Tailscale for remote access), 0.0.0.0 = whole LAN over plain HTTP
DASHBOARD_BIND=127.0.0.1
# true needs HTTPS or localhost; set false only together with DASHBOARD_BIND=0.0.0.0 on plain HTTP
DASHBOARD_COOKIE_SECURE=true
CLOUDFLARE_TUNNEL_TOKEN=
